<?xml version="1.0" encoding="utf-8"?>
<!-- Replay (2×2 made short, 1.8.5): the cover small beside its label, so the title and artist still fit at 110 dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:backgroundTint="#FF1B1B22"
    android:clipToOutline="true">

    <FrameLayout
        android:id="@+id/rp_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_replay_open"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/rp_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/rp_song_art"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_art_frame"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_notification" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/rp_song_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:maxLines="2"
                        android:text="@string/widget_replay_song_label"
                        android:textAlignment="viewStart"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9sp" />

                    <ImageView
                        android:id="@+id/rp_dash"
                        android:layout_width="20dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="4dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_spectrum_bar" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="4dp" />

            <TextView
                android:id="@+id/rp_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rp_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="#BFFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rp_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/rp_mark"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_notification" />

            <TextView
                android:id="@+id/rp_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="3"
                android:text="@string/widget_replay_empty"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
